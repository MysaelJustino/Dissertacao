# como estratos, permitindo riscos basais distintos.
#
# A idade de ingresso apresentou evidência de violação da
# hipótese de riscos proporcionais. Por isso, seu efeito
# pode variar ao longo dos semestres por meio de tt().


### ADICIONADO NA TABELA 16 JUNTO COM COX_ENEM - CAPITULO 4.5.3 ###
cox_final <- coxph(
  Surv(
    semestres_ate_evento,
    evento
  ) ~
    cota +
    raca +
    idade_ingresso_c +
    idade_ingresso_c2 +
    dummyescolapublica +
    tt(idade_ingresso_c) +
    strata(
      ano_ingresso,
      unidade_responsavel,
      sexo.x
    ),
  data = base_final,
  ties = "efron",
  tt = function(x, t, ...) {
    x * log(t)
  },
  x = TRUE
)

